{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Note+",
  "version": "0.3.0",
  "identifier": "lv.noteplus.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Note+",
        "width": 1280,
        "height": 820,
        "minWidth": 640,
        "minHeight": 480,
        "dragDropEnabled": false,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}